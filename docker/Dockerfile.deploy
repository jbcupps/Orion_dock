# Deploy image: build release binaries and produce a minimal runnable image.
# Build: docker build -f docker/Dockerfile.deploy -t orion:latest .
# Push: docker tag orion:latest <registry>/orion:<tag> && docker push <registry>/orion:<tag>

ARG RUST_VERSION=1.75

# ---- builder ----
FROM rust:${RUST_VERSION}-bookworm AS builder
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./
COPY crates ./crates
COPY skills ./skills

# Mount cache for faster rebuilds (optional at build time)
RUN mkdir -p target
RUN cargo build --release -p soul-forge

# ---- runtime ----
FROM debian:bookworm-slim
RUN apt-get update -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/soul-forge /app/soul-forge

# Default: run soul-forge (TUI). Override in k8s/docker run for other entrypoints.
ENV PATH="/app:${PATH}"
CMD ["/app/soul-forge"]
